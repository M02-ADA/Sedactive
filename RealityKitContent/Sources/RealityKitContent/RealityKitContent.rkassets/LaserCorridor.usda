    def Xform "EditorPreviews" (
        doc = "Reality Composer Pro reference only. LaserScene removes this group at runtime; move Root/Anchors to change real placement."
    )
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        float3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def Scope "PreviewMaterials"
        {
            def Material "PlayerParent"
            {
                token outputs:mtlx:surface.connect = </Root/EditorPreviews/PreviewMaterials/PlayerParent/Unlit.outputs:out>
                token outputs:realitykit:vertex
                token outputs:surface

                def Shader "Unlit"
                {
                    uniform token info:id = "ND_realitykit_unlit_surfaceshader"
                    bool inputs:applyPostProcessToneMap = 0
                    color3f inputs:color.connect = </Root/EditorPreviews/PreviewMaterials/PlayerParent/Color.outputs:out>
                    float inputs:opacity.connect = </Root/EditorPreviews/PreviewMaterials/PlayerParent/Channels.outputs:outa>
